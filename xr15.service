[Unit]
Description=EcoTech Marine XR15w BLE HTTP Bridge
After=network.target bluetooth.target
Wants=bluetooth.target

[Service]
Type=simple
User=ugurbaykoc
WorkingDirectory=/home/ugurbaykoc
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ugurbaykoc/xr15-venv/bin/python3 -u /home/ugurbaykoc/xr15_server.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
